{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistant-cat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  // Roda antes de `wrangler deploy`/`dev`: instala as deps de `app/` e gera `app/dist`.
  // Sem isto, um deploy limpo (Workers Builds) falha com "assets.directory does not exist".
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    // O app não tem rotas de cliente: caminho inexistente devolve 404 real
    // (app/public/404.html) em vez de index.html com status 200.
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Rate limit nativo para o proxy /api/ai (30 req/min por IP).
  // O Worker usa fallback em memória quando este binding não está disponível (dev).
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "2026102401",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
