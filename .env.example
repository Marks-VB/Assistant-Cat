# Assistant Cat — variáveis de ambiente
#
# Copie para `.env` e preencha só o que for usar. Em produção o `.env` NÃO é lido
# pelo Worker: lá use `npx wrangler secret put NOME` para segredos e as variáveis
# de build do Workers Builds para as `VITE_*`.

# ============================================================
# Server-side (nunca vão para o bundle)
# ============================================================

# Chaves de fallback do proxy /api/ai (Worker) e do server.cjs local.
# O app pode enviar a própria chave (BYOK); o secret só é usado quando o corpo
# da requisição não traz `apiKey`.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Allowlist de CORS do Worker: origens separadas por vírgula.
# Inclua https://localhost para o APK (WebView do Capacitor). Exemplo:
# ALLOWED_ORIGINS=https://assistant-cat.SEUSUBDOMINIO.workers.dev,https://localhost
ALLOWED_ORIGINS=

# O rate limit usa o binding AI_RATE_LIMITER (wrangler.jsonc/dashboard),
# não uma variável de ambiente.

# DSN do Sentry no servidor (server.cjs). O app usa VITE_SENTRY_DSN.
SENTRY_DSN=

# Porta do server.cjs local. Padrão: 3001. Não afeta o Worker.
PORT=3001

# development | production — ambiente relatado ao Sentry no servidor.
NODE_ENV=production

# ============================================================
# Build-time (Vite) — ficam visíveis no bundle, não são segredo
# ============================================================

# Domínio canônico do site, usado por sitemap.xml, robots.txt e Open Graph.
# Ex.: VITE_SITE_URL=https://assistant-cat.SEUSUBDOMINIO.workers.dev
# Vazio: sitemap sem URLs e OG sem endereço absoluto.
VITE_SITE_URL=

# DSN público do Sentry. Vazio: initSentry() não inicializa e nada é enviado.
VITE_SENTRY_DSN=
