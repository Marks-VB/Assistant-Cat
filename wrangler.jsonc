{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistant-cat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  // Roda antes de `wrangler deploy`/`dev`: instala as deps de `app/` e gera `app/dist`.
  // Sem isto, um deploy limpo (Workers Builds) falha com "assets.directory does not exist".
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
