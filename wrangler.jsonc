{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistant-cat",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
